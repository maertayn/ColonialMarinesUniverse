<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:style="clr-namespace:Content.Client.Stylesheets"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:lineup="clr-namespace:Content.Client.CMU14.Lobby"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets"
    xmlns:cmu="clr-namespace:Content.Client.CMU14.Interface">
    <!-- Background -->
    <TextureRect Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background"
                 Stretch="KeepAspectCovered" />
    <BoxContainer Name="MainContainer" VerticalExpand="True" HorizontalExpand="True" Orientation="Horizontal"
                  Margin="10 10 10 10" SeparationOverride="2">
        <SplitContainer State="Auto" ResizeMode="NotResizable" HorizontalExpand="True">
            <!-- LHS Controls -->
            <BoxContainer Name="LeftSide" Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True">
                <Control Name="DefaultState" VerticalExpand="True">
                    <BoxContainer Name="TopLeft" Orientation="Vertical">
                        <!-- Left Top Panel -->
                        <!-- Ticked panel so this reads as the same piece of equipment as a VotePopup. -->
                        <PanelContainer StyleClasses="CrtPanelTicked" HorizontalAlignment="Left" Name="LeftSideTop"
                                        VerticalAlignment="Top">
                            <BoxContainer Orientation="Vertical" SeparationOverride="5" MaxWidth="1040"
                                          MinWidth="{x:Static cmu:CmuPanelMetrics.LobbyActionColumnWidth}">
                                <!-- Ranked, not a grid of equals. -->
                                <BoxContainer Name="ActionButtons" Orientation="Vertical" HorizontalExpand="True"
                                              SeparationOverride="{x:Static cmu:CmuPanelMetrics.GroupSeparation}">
                                    <!-- The clock, folded. The countdown is the button's own label so
                                         this stays one control, not a panel inside the panel. -->
                                    <Button Name="DockedClockButton" Access="Public"
                                            ToolTip="{Loc 'cmu-lobby-clock-restore-tooltip'}"
                                            HorizontalExpand="True" Visible="False"
                                            MinHeight="{x:Static cmu:CmuPanelMetrics.Row}" />
                                    <!-- CrtReadyToggle, not ButtonBig: this control says which of two
                                         states you are in, where a button box says only that it is
                                         pressable. CrtLobbyTheme withholds its own class from this. -->
                                    <Button Name="ReadyButton" Access="Public" ToggleMode="True"
                                            Text="{Loc 'ui-lobby-ready-up-button'}"
                                            StyleClasses="CrtReadyToggle" HorizontalExpand="True"
                                            MinHeight="{x:Static cmu:CmuPanelMetrics.RowTall}" />
                                    <!-- RMC14/AU -->
                                    <Button Name="JoinRoundButton" Access="Public"
                                            Text="{Loc 'cmu-lobby-join-round'}"
                                            StyleClasses="ButtonBig" HorizontalExpand="True"
                                            MinHeight="{x:Static cmu:CmuPanelMetrics.Row}"
                                            Visible="False" />
                                    <!-- A rule, not just a gap. -->
                                    <PanelContainer StyleClasses="CrtDivider" />
                                    <cc:UICommandButton Command="observe" Name="ObserveButton" Access="Public"
                                                        Text="{Loc 'ui-lobby-observe-button'}"
                                                        StyleClasses="ButtonBig" HorizontalExpand="True"
                                                        MinHeight="{x:Static cmu:CmuPanelMetrics.RowCompact}"
                                                        WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />
                                </BoxContainer>

                                <!-- Reference links share the action grid's metrics but sit under a rule,
                                     so Rules doesn't read as another faction choice. -->
                                <PanelContainer StyleClasses="CrtDivider" />
                                <info:LinkBanner Name="LinkBanner" VerticalExpand="false" HorizontalExpand="True" />
                                <RichTextLabel Name="PlaytimeComment" Visible="False" Access="Public" HorizontalAlignment="Center" />
                            </BoxContainer>
                        </PanelContainer>
                        <!-- Voting Popups -->
                        <BoxContainer Orientation="Vertical" SeparationOverride="4" Name="VoteContainer"
                                      Access="Public" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0 8" />
                        <lineup:LobbyLineupPanel Name="Lineup" Access="Public" VerticalExpand="True"
                                                 HorizontalExpand="True" Margin="0 4 8 110" />
                    </BoxContainer>
                    <!-- Vertical Padding-->
                    <Control VerticalExpand="True" />
                    <!-- Left Bot Panel -->
                    <PanelContainer VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                    Margin="0 75" StyleClasses="CrtPanel">
                        <RichTextLabel Name="LobbyMessageLabel" Access="Public" Margin="5" />
                    </PanelContainer>
                    <BoxContainer Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <info:DevInfoBanner Name="DevInfoBanner" VerticalExpand="false" Margin="3 3 3 3" />
                        <PanelContainer StyleClasses="CrtPanel" Margin="3 3 3 3">
                            <BoxContainer Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3 3 3 3">
                                <RichTextLabel Name="LobbySong" Access="Public" HorizontalAlignment="Left" />
                                <RichTextLabel Name="LobbyBackground" Access="Public" HorizontalAlignment="Left" />
                            </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>
                </Control>
                <!-- Character setup state -->
                <!-- This is injected on startup. Funky! -->
                <Control Access="Public" Visible="False" Name="CharacterSetupState" VerticalExpand="True" />
            </BoxContainer>
            <!-- Right Panel -->
            <PanelContainer Name="RightSide" Access="Public" StyleClasses="CrtScreenPanel" HorizontalAlignment="Right" VerticalExpand="True"
                            VerticalAlignment="Stretch">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <!-- The nameplate, on the plastic above the screen rather than printed inside it. It
                     cannot sit in the captured subtree or the roll bar would shear it. -->
                <BoxContainer Name="LobbyPlate" Orientation="Horizontal" HorizontalExpand="True"
                              Margin="4 0 4 4" SeparationOverride="8">
                    <Label Name="ServerName" Access="Public" StyleClasses="CrtHeadingSmall"
                           Text="{Loc 'cmu-lobby-plate-name'}"
                           VAlign="Center" HorizontalExpand="True" ClipText="True" />
                    <Label Name="PlateSerial" Access="Public" Text="{Loc 'cmu-lobby-plate-serial'}"
                           VAlign="Center" Visible="False" />
                </BoxContainer>
                <!-- The command row, on the case with the plate rather than on the screen. -->
                <PanelContainer Name="CommandBand" Access="Public" StyleClasses="CrtCommandBand"
                                MinHeight="{x:Static cmu:CmuPanelMetrics.RowCompact}">
                    <BoxContainer Orientation="Horizontal" Name="HeaderContainer" Access="Public"
                                  SeparationOverride="1" HorizontalExpand="True">
                        <Button Name="AHelpButton" Access="Public" Text="{Loc 'ui-lobby-ahelp-button'}"
                                StyleClasses="CrtCommandCell" HorizontalExpand="True" VerticalExpand="True" />
                        <vote:VoteCallMenuButton Name="CallVoteButton" Access="Public" StyleClasses="CrtCommandCell"
                                                 HorizontalExpand="True" VerticalExpand="True" />
                        <Button Name="OptionsButton" Access="Public" StyleClasses="CrtCommandCell"
                                Text="{Loc 'ui-lobby-options-button'}" HorizontalExpand="True" VerticalExpand="True" />
                        <Button Name="LeaveButton" Access="Public" StyleClasses="CrtCommandCell"
                                Text="{Loc 'ui-lobby-leave-button'}" HorizontalExpand="True" VerticalExpand="True" />
                        <!-- The arrow keeps its natural width: it is an affordance on the panel, not a
                             fifth command, and stretching it to a fifth of the row would say otherwise. -->
                        <PanelContainer Name="CollapseCell" Access="Public"
                                        StyleClasses="CrtCommandCellPanel" VerticalExpand="True">
                            <TextureButton Name="CollapseButton"
                                           TexturePath="filled_right_arrow.svg.192dpi"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="4 0 4 0"
                                           Scale="0.5 0.5" />
                        </PanelContainer>
                    </BoxContainer>
                </PanelContainer>
                <controls:HSpacer Spacing="4" />
                <!-- The server/character switch: a two-position detent toggle on the case rather than a
                     tab on the glass. Housing only; with it off both blocks stay stacked. -->
                <PanelContainer Name="PanelSwitch" Access="Public" HorizontalExpand="True"
                                Visible="False" Margin="0 0 0 4">
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="2">
                        <Button Name="ServerPanelButton" Access="Public" HorizontalExpand="True"
                                Text="{Loc 'cmu-lobby-panel-server'}" />
                        <Button Name="CharacterPanelButton" Access="Public" HorizontalExpand="True"
                                Text="{Loc 'cmu-lobby-panel-character'}" />
                    </BoxContainer>
                </PanelContainer>
                <!-- One glass for the whole column. -->
                <PanelContainer Name="LobbyScreen" Access="Public" HorizontalExpand="True">
                <!-- Everything above the chat is one CRT screen: the header row, the server info block
                     and the character block. -->
                <Control Name="LobbyCrtScreen" HorizontalExpand="True"
                         MinHeight="{x:Static cmu:CmuPanelMetrics.LobbyPanelHeight}">
                    <Control Name="LobbyCrtContent" HorizontalExpand="True">
                        <PanelContainer Name="LobbyCrtBacking" HorizontalExpand="True"
                                        VerticalExpand="True" />
                        <!-- The inset lives here, not on RightSide. -->
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True"
                                      Margin="10 8 10 8">
                            <!-- The server name and the command row both used to head this column. -->
                            <!-- Server info: heading and intro text share the top row. Wrapped for the
                                 CRT effect. -->
                            <Control Name="ServerInfoScreen" Access="Public" HorizontalExpand="True" VerticalExpand="True" Margin="0 0 0 3">
                                <Control Name="ServerInfoContent" HorizontalExpand="True" VerticalExpand="True">
                                    <PanelContainer Name="ServerInfoBacking" HorizontalExpand="True"
                                                    VerticalExpand="True" />
                                    <!-- Inset, not flush. -->
                                    <info:ServerInfo Name="ServerInfo" Access="Public" VerticalExpand="True"
                                           HorizontalExpand="True" />
                                </Control>
                            </Control>
                            <controls:HSpacer Spacing="5" />
                            <!-- Expands so its own head/body/foot spacers have slack: at natural height
                                 the foot sits under the body rather than on the bottom edge. -->
                            <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public"
                                                                VerticalExpand="True" />
                        </BoxContainer>
                    </Control>
                    <cmu:CrtScreenControl Name="LobbyCrt" HorizontalExpand="True"
                                          VerticalExpand="True" />
                </Control>
                </PanelContainer>
                <!-- The join - and a sibling of the two screens, not something drawn inside one of them. -->
                <PanelContainer Name="LobbySeam" Access="Public" HorizontalExpand="True"
                                MinHeight="16" Visible="False" />
                <PanelContainer Name="ChatScreen" Access="Public" HorizontalExpand="True"
                                VerticalExpand="True">
                    <!-- Scanlines over the chat, as an overlay rather than a shader pass. -->
                    <Control Name="ChatCrtScreen" HorizontalExpand="True" VerticalExpand="True">
                        <widgets:ChatBox Name="Chat" Access="Public" VerticalExpand="True"
                                         Margin="0 0 0 0" MinHeight="50" />
                        <cmu:CrtScanlineOverlay Name="ChatScanlines" HorizontalExpand="True"
                                                VerticalExpand="True" />
                    </Control>
                </PanelContainer>
                </BoxContainer>
            </PanelContainer>
        </SplitContainer>
        <!-- Takes the collapse arrow's place, so it has to land on the same pixel or the arrow jumps as
             the panel opens and closes. -->
        <PanelContainer Name="ExpandPanel"
                        StyleClasses="CrtPanel"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0 0 2 0"
                        Visible="False">
            <BoxContainer Orientation="Horizontal" MinHeight="{x:Static cmu:CmuPanelMetrics.Header}">
                <TextureButton Name="ExpandButton"
                            TexturePath="filled_left_arrow.svg.192dpi"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Scale="0.5 0.5"/>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
    <!-- The round clock. -->
    <LayoutContainer Name="ClockLayer" Access="Public" MouseFilter="Ignore"
                     HorizontalExpand="True" VerticalExpand="True">
        <cmu:CmuDraggablePanel Name="RoundClock" Access="Public" StyleClasses="CrtPanelTicked">
            <BoxContainer Orientation="Vertical" SeparationOverride="1"
                          Margin="{x:Static cmu:CmuPanelMetrics.ContentPadding}">
                <!-- Fold control on the caption line, not over the body: the body is the drag handle. -->
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <Label Name="ClockCaption" Access="Public" Align="Center"
                           StyleClasses="CrtDimText" HorizontalExpand="True" />
                    <!-- CrtLobbyTheme never reaches this subtree (it runs on MainContainer only), so
                         CmuIconButton colours itself. -->
                    <cmu:CmuIconButton Name="ClockMinimizeButton" Access="Public"
                                       TexturePath="/Textures/Interface/Default/filled_left_arrow.svg.192dpi.png"
                                       ToolTip="{Loc 'cmu-lobby-clock-minimize-tooltip'}" />
                </BoxContainer>
                <Label Name="StartTime" Access="Public" Align="Center"
                       StyleClasses="CrtClock" MinWidth="190" />
                <Label Name="LobbyStatusLine" Access="Public" Align="Center"
                       StyleClasses="CrtDimText" Visible="False" />
            </BoxContainer>
        </cmu:CmuDraggablePanel>
    </LayoutContainer>
    <BoxContainer Name="BalanceRatingContainer"
                  Access="Public"
                  Orientation="Vertical"
                  SeparationOverride="4"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  MouseFilter="Ignore" />
</lobbyUi:LobbyGui>
